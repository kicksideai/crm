{
  "name": "@kickside/crm-ui",
  "version": "0.1.0",
  "specification": "wippy-component-1.0",
  "title": "kickside CRM UI",
  "description": "Maintained Vue surfaces for CRM records, boards, timelines, settings, record picking, and identity review.",
  "browser": "dist/surface.js",
  "files": [
    "dist/",
    "src/",
    "package.json"
  ],
  "type": "module",
  "dependencies": {
    "@wippy-fe/theme": "*",
    "@wippy-fe/webcomponent-core": "*",
    "@wippy-fe/webcomponent-vue": "*",
    "primevue": "^4.5.5"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "@wippy-fe/proxy": "*",
    "@wippy-fe/vite-plugin": "*",
    "happy-dom": "^20.10.6",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.12"
  },
  "peerDependencies": {
    "@wippy-fe/proxy": "*",
    "vue": "^3.5.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "wippy": {
    "tagName": "kickside-crm-surface",
    "type": "component",
    "description": "Render the complete CRM workspace for a selected component. Pass component-id to bind the CRM and route to open an object, record, review queue, or data-model view; listen for navigate when the host should persist a route change. The surface reads its declared schema and never assumes business object types.",
    "props": {
      "type": "object",
      "properties": {
        "route": {
          "type": "string",
          "default": "",
          "description": "CRM object, record, review, or model route."
        },
        "component-id": {
          "type": "string",
          "default": "",
          "description": "CRM component id."
        }
      }
    },
    "events": {
      "type": "object",
      "properties": {
        "navigate": {
          "type": "object",
          "properties": {
            "route": {
              "type": "string"
            }
          }
        }
      }
    },
    "scripts": {
      "build": "build"
    }
  },
  "scripts": {
    "build": "vite build && node scripts/sync-static.mjs",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit"
  }
}
